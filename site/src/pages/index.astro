---
// bettersense landing page
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="An operating system for AI PMs, Engineering Leaders, and Senior ICs — structured thinking tools that transform how you handle strategy, stakeholder relationships, AI decisions, and the judgment calls that define your career." />
    <meta property="og:title" content="bettersense — Operating system for technical leaders in Claude Code" />
    <meta property="og:description" content="An operating system for AI PMs, Engineering Leaders, and Senior ICs — structured thinking tools that transform how you handle strategy, stakeholder relationships, AI decisions, and the judgment calls that define your career." />
    <meta property="og:url" content="https://bettersense.ai" />
    <title>bettersense — Operating system for technical leaders in Claude Code</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400..700&family=Inter:wght@400..600&display=swap" />
    <style is:global>
      *, *::before, *::after { box-sizing: border-box; }

      :root {
        --bg:        #111110;
        --bg-card:   #181614;
        --border:    #252220;
        --text:      #d4c9bf;
        --text-dim:  #8a7e74;
        --text-head: #f4ede4;
        --accent:    #c9a46e;
        --accent-lo: #2a1f0e;
        --font-body: 'Inter', ui-sans-serif, system-ui, sans-serif;
        --font-head: 'Bricolage Grotesque', ui-sans-serif, system-ui, sans-serif;
      }

      html { background: var(--bg); color: var(--text); }

      body {
        margin: 0;
        font-family: var(--font-body);
        font-size: 1rem;
        line-height: 1.7;
        -webkit-font-smoothing: antialiased;
      }

      a { color: var(--accent); text-decoration: none; }
      a:hover { text-decoration: underline; }
    </style>
  </head>
  <body>

    <!-- ── Nav ─────────────────────────────────────── -->
    <nav style="
      position: sticky; top: 0; z-index: 100;
      display: flex; align-items: center; justify-content: space-between;
      padding: 0 2rem; height: 3.5rem;
      background: rgba(17,17,16,0.85); backdrop-filter: blur(12px);
      border-bottom: 1px solid var(--border);
    ">
      <span style="font-family: var(--font-head); font-weight: 600; font-size: 1.05rem; letter-spacing: -0.02em; color: var(--text-head);">
        bettersense
      </span>
      <div style="display: flex; align-items: center; gap: 1.5rem; font-size: 0.88rem; color: var(--text-dim);">
        <a href="/getting-started/install" style="color: var(--text-dim);">Docs</a>
        <a href="https://github.com/shwetank/bettersense" style="color: var(--text-dim);">GitHub</a>
        <a href="/getting-started/install" style="
          padding: 0.4rem 1rem;
          background: var(--accent); color: #111110;
          border-radius: 6px; font-weight: 600; font-size: 0.85rem;
          white-space: nowrap;
        ">Get started</a>
      </div>
    </nav>

    <!-- ── Hero ───────────────────────────────────── -->
    <section style="
      padding: 7rem 2rem 6rem;
      text-align: center;
      background:
        radial-gradient(ellipse 80% 50% at 50% -10%, rgba(201,164,110,0.08) 0%, transparent 60%);
    ">
      <div style="max-width: 720px; margin: 0 auto;">

        <p style="
          display: inline-block;
          font-size: 0.75rem; font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase;
          color: var(--accent); background: var(--accent-lo);
          padding: 0.3em 0.9em; border-radius: 999px; margin-bottom: 1.5rem;
        ">Claude Code plugin</p>

        <h1 style="
          font-family: var(--font-head);
          font-size: clamp(2.4rem, 5vw, 3.5rem);
          font-weight: 700; letter-spacing: -0.03em;
          color: var(--text-head);
          margin: 0 0 1.25rem;
          line-height: 1.15;
        ">Think more clearly<br>about your work.</h1>

        <p style="
          font-size: clamp(1rem, 2vw, 1.2rem);
          color: var(--text-dim); max-width: 560px; margin: 0 auto 2.5rem;
          line-height: 1.65;
        ">
          An operating system for <strong style="color: var(--text);">AI PMs, Engineering Leaders, and Senior ICs</strong> — structured thinking tools that transform how you handle strategy, stakeholder relationships, AI decisions, and the judgment calls that define your career.
        </p>

        <!-- Install steps -->
        <div style="display: flex; flex-direction: column; gap: 0.6rem; margin-bottom: 1rem; text-align: left; max-width: 480px; margin-left: auto; margin-right: auto;">

          <!-- Step 1 -->
          <div style="display: flex; align-items: center; gap: 0.75rem;">
            <span style="
              flex-shrink: 0; width: 1.4rem; height: 1.4rem;
              background: var(--accent-lo); border: 1px solid rgba(201,164,110,0.3);
              border-radius: 50%; display: flex; align-items: center; justify-content: center;
              font-size: 0.7rem; font-weight: 700; color: var(--accent);
            ">1</span>
            <div style="
              flex: 1; display: flex; align-items: center; gap: 0;
              background: var(--bg-card); border: 1px solid var(--border);
              border-radius: 8px; overflow: hidden;
            ">
              <code style="
                flex: 1; font-family: 'SF Mono', 'Fira Code', 'Cascadia Code', monospace;
                font-size: 0.84rem; color: var(--text); padding: 0.7rem 1rem;
                white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
              ">/plugin marketplace add shwetank/bettersense</code>
              <button
                id="copy-btn-1"
                onclick="copyCmd('copy-btn-1', '/plugin marketplace add shwetank/bettersense')"
                title="Copy to clipboard"
                style="
                  flex-shrink: 0; padding: 0.7rem 0.85rem;
                  background: transparent; border: none; border-left: 1px solid var(--border);
                  color: var(--text-dim); cursor: pointer;
                  transition: color 0.15s, background 0.15s;
                "
                onmouseover="this.style.background='rgba(201,164,110,0.08)';this.style.color='var(--accent)'"
                onmouseout="this.style.background='transparent';this.style.color='var(--text-dim)'"
              >
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <rect width="14" height="14" x="8" y="8" rx="2" ry="2"/>
                  <path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/>
                </svg>
              </button>
            </div>
          </div>

          <!-- Step 2 -->
          <div style="display: flex; align-items: center; gap: 0.75rem;">
            <span style="
              flex-shrink: 0; width: 1.4rem; height: 1.4rem;
              background: var(--accent-lo); border: 1px solid rgba(201,164,110,0.3);
              border-radius: 50%; display: flex; align-items: center; justify-content: center;
              font-size: 0.7rem; font-weight: 700; color: var(--accent);
            ">2</span>
            <div style="
              flex: 1; display: flex; align-items: center; gap: 0;
              background: var(--bg-card); border: 1px solid var(--border);
              border-radius: 8px; overflow: hidden;
            ">
              <code style="
                flex: 1; font-family: 'SF Mono', 'Fira Code', 'Cascadia Code', monospace;
                font-size: 0.84rem; color: var(--text); padding: 0.7rem 1rem;
                white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
              ">/plugin install bettersense@bettersense</code>
              <button
                id="copy-btn-2"
                onclick="copyCmd('copy-btn-2', '/plugin install bettersense@bettersense')"
                title="Copy to clipboard"
                style="
                  flex-shrink: 0; padding: 0.7rem 0.85rem;
                  background: transparent; border: none; border-left: 1px solid var(--border);
                  color: var(--text-dim); cursor: pointer;
                  transition: color 0.15s, background 0.15s;
                "
                onmouseover="this.style.background='rgba(201,164,110,0.08)';this.style.color='var(--accent)'"
                onmouseout="this.style.background='transparent';this.style.color='var(--text-dim)'"
              >
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <rect width="14" height="14" x="8" y="8" rx="2" ry="2"/>
                  <path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/>
                </svg>
              </button>
            </div>
          </div>

        </div>

        <p style="font-size: 0.8rem; color: var(--text-dim); margin-bottom: 0;">
          Paste into <strong style="color: var(--text);">Claude</strong>. Install in 60 seconds. Start using expert frameworks immediately.
        </p>

        <div style="margin-top: 2rem; display: flex; align-items: center; justify-content: center; gap: 1rem; flex-wrap: wrap;">
<a href="/getting-started/install" style="
            display: inline-flex; align-items: center; gap: 0.4rem;
            padding: 0.65rem 1.4rem;
            background: var(--accent); color: #111110;
            border-radius: 8px; font-weight: 600; font-size: 0.95rem;
          ">
            Get started
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
          </a>
        </div>

      </div>
    </section>

    <!-- ── Feature grid ─────────────────────────────── -->
    <section style="padding: 4rem 2rem 6rem; max-width: 1100px; margin: 0 auto;">

      <h2 style="
        font-family: var(--font-head); font-weight: 600; letter-spacing: -0.02em;
        font-size: 1.05rem; text-align: center; color: var(--text-dim);
        text-transform: uppercase; letter-spacing: 0.08em; font-size: 0.75rem;
        margin-bottom: 3rem;
      ">What's inside</h2>

      <div style="
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
        gap: 1.25rem;
      ">
        <!-- Card 1 -->
        <a href="/skills/stakeholder-management" class="feature-card" style="
          display: block;
          background: var(--bg-card); border: 1px solid var(--border);
          border-radius: 12px; padding: 1.75rem;
          transition: border-color 0.2s, transform 0.2s;
          text-decoration: none;
        "
        onmouseover="this.style.borderColor='var(--accent)';this.style.transform='translateY(-2px)'"
        onmouseout="this.style.borderColor='var(--border)';this.style.transform='translateY(0)'">
          <div style="font-size: 1.6rem; margin-bottom: 0.85rem;">🤝</div>
          <h3 style="font-family: var(--font-head); font-weight: 600; font-size: 1.05rem; color: var(--text-head); margin: 0 0 0.6rem; letter-spacing: -0.01em;">Stakeholder clarity</h3>
          <p style="color: var(--text-dim); font-size: 0.9rem; margin: 0; line-height: 1.6;">
            Five skills that accumulate structured insight about your working relationships over months — so your 1:1s, skip-levels, and hard conversations get sharper, not vaguer.
          </p>
          <p style="margin: 1rem 0 0; font-size: 0.82rem; color: var(--accent);">stakeholder-register · stakeholder-reflect · stakeholder-synthesize →</p>
        </a>

        <!-- Card 2 -->
        <a href="/skills/wins-system" class="feature-card" style="
          display: block;
          background: var(--bg-card); border: 1px solid var(--border);
          border-radius: 12px; padding: 1.75rem;
          transition: border-color 0.2s, transform 0.2s;
          text-decoration: none;
        "
        onmouseover="this.style.borderColor='var(--accent)';this.style.transform='translateY(-2px)'"
        onmouseout="this.style.borderColor='var(--border)';this.style.transform='translateY(0)'">
          <div style="font-size: 1.6rem; margin-bottom: 0.85rem;">🏆</div>
          <h3 style="font-family: var(--font-head); font-weight: 600; font-size: 1.05rem; color: var(--text-head); margin: 0 0 0.6rem; letter-spacing: -0.01em;">Wins that stick</h3>
          <p style="color: var(--text-dim); font-size: 0.9rem; margin: 0; line-height: 1.6;">
            Log your impact honestly as it happens. When the promo cycle, interview, or salary review arrives, curate it into a calibrated, citation-backed artifact — not a scramble.
          </p>
          <p style="margin: 1rem 0 0; font-size: 0.82rem; color: var(--accent);">wins-log · wins-due · wins-curate →</p>
        </a>

        <!-- Card 3 -->
        <a href="/skills/strategy" class="feature-card" style="
          display: block;
          background: var(--bg-card); border: 1px solid var(--border);
          border-radius: 12px; padding: 1.75rem;
          transition: border-color 0.2s, transform 0.2s;
          text-decoration: none;
        "
        onmouseover="this.style.borderColor='var(--accent)';this.style.transform='translateY(-2px)'"
        onmouseout="this.style.borderColor='var(--border)';this.style.transform='translateY(0)'">
          <div style="font-size: 1.6rem; margin-bottom: 0.85rem;">🗺️</div>
          <h3 style="font-family: var(--font-head); font-weight: 600; font-size: 1.05rem; color: var(--text-head); margin: 0 0 0.6rem; letter-spacing: -0.01em;">Strategic anchor</h3>
          <p style="color: var(--text-dim); font-size: 0.9rem; margin: 0; line-height: 1.6;">
            A strategy doc other skills actually read — target problem, approach, personas, SMART metrics, tracks, and the load-bearing "not working on" section that heads off distraction.
          </p>
          <p style="margin: 1rem 0 0; font-size: 0.82rem; color: var(--accent);">strategy-doc · product-pulse · pulse-synthesize →</p>
        </a>

        <!-- Card 4 -->
        <a href="/skills/people-leadership" class="feature-card" style="
          display: block;
          background: var(--bg-card); border: 1px solid var(--border);
          border-radius: 12px; padding: 1.75rem;
          transition: border-color 0.2s, transform 0.2s;
          text-decoration: none;
        "
        onmouseover="this.style.borderColor='var(--accent)';this.style.transform='translateY(-2px)'"
        onmouseout="this.style.borderColor='var(--border)';this.style.transform='translateY(0)'">
          <div style="font-size: 1.6rem; margin-bottom: 0.85rem;">🧭</div>
          <h3 style="font-family: var(--font-head); font-weight: 600; font-size: 1.05rem; color: var(--text-head); margin: 0 0 0.6rem; letter-spacing: -0.01em;">Leadership OS</h3>
          <p style="color: var(--text-dim); font-size: 0.9rem; margin: 0; line-height: 1.6;">
            Coaching, feedback, 1:1s, performance, promotion cases, team health — frameworks that hold up in real situations, not templated cheerleading.
          </p>
          <p style="margin: 1rem 0 0; font-size: 0.82rem; color: var(--accent);">coaching-mode · feedback-frameworks · performance-management →</p>
        </a>

        <!-- Card 5 -->
        <a href="/skills/ai-product-craft" class="feature-card" style="
          display: block;
          background: var(--bg-card); border: 1px solid var(--border);
          border-radius: 12px; padding: 1.75rem;
          transition: border-color 0.2s, transform 0.2s;
          text-decoration: none;
        "
        onmouseover="this.style.borderColor='var(--accent)';this.style.transform='translateY(-2px)'"
        onmouseout="this.style.borderColor='var(--border)';this.style.transform='translateY(0)'">
          <div style="font-size: 1.6rem; margin-bottom: 0.85rem;">🔬</div>
          <h3 style="font-family: var(--font-head); font-weight: 600; font-size: 1.05rem; color: var(--text-head); margin: 0 0 0.6rem; letter-spacing: -0.01em;">AI product craft</h3>
          <p style="color: var(--text-dim); font-size: 0.9rem; margin: 0; line-height: 1.6;">
            Whether to use AI at all, eval harnesses before committing engineering, red-teaming before launch, translating model metrics into outcomes. Anti-hype, opinionated.
          </p>
          <p style="margin: 1rem 0 0; font-size: 0.82rem; color: var(--accent);">ai-pm-frameworks · metrics-design · the-eval-designer →</p>
        </a>

        <!-- Card 6 -->
        <a href="/skills/cross-cutting" class="feature-card" style="
          display: block;
          background: var(--bg-card); border: 1px solid var(--border);
          border-radius: 12px; padding: 1.75rem;
          transition: border-color 0.2s, transform 0.2s;
          text-decoration: none;
        "
        onmouseover="this.style.borderColor='var(--accent)';this.style.transform='translateY(-2px)'"
        onmouseout="this.style.borderColor='var(--border)';this.style.transform='translateY(0)'">
          <div style="font-size: 1.6rem; margin-bottom: 0.85rem;">🔄</div>
          <h3 style="font-family: var(--font-head); font-weight: 600; font-size: 1.05rem; color: var(--text-head); margin: 0 0 0.6rem; letter-spacing: -0.01em;">Cross-cutting skills</h3>
          <p style="color: var(--text-dim); font-size: 0.9rem; margin: 0; line-height: 1.6;">
            Pattern detection across your reflection data, decision logging that survives the next model migration, meeting subtext, influence without authority, and more.
          </p>
          <p style="margin: 1rem 0 0; font-size: 0.82rem; color: var(--accent);">patterns-watch · decision-log · read-the-room →</p>
        </a>
      </div>
    </section>

    <!-- ── "What these add" section ─────────────────── -->
    <section style="
      padding: 5rem 2rem;
      border-top: 1px solid var(--border);
      background: radial-gradient(ellipse 60% 40% at 80% 50%, rgba(201,164,110,0.04) 0%, transparent 60%);
    ">
      <div style="max-width: 860px; margin: 0 auto; display: grid; grid-template-columns: 1fr 1fr; gap: 4rem; align-items: center;">
        <div>
<h2 style="
              font-family: var(--font-head); font-size: clamp(1.6rem, 3vw, 2.2rem);
              font-weight: 700; letter-spacing: -0.025em; color: var(--text-head);
              margin: 0 0 1.25rem; line-height: 1.2;
            ">Why not just ask<br>Claude directly?</h2>
            <p style="color: var(--text-dim); line-height: 1.7; margin: 0 0 1rem;">
              Two things skills add that plain prompts don't:
            </p>
          <ul style="list-style: none; padding: 0; margin: 0; color: var(--text-dim); font-size: 0.95rem; line-height: 1.7;">
            <li style="display: flex; gap: 0.75rem; margin-bottom: 1rem;">
              <span style="color: var(--accent); flex-shrink: 0; margin-top: 0.1em;">→</span>
              <span><strong style="color: var(--text);">Auto-routing.</strong> You describe the situation. Claude pulls in the right framework without you remembering its name. At 4:47pm Friday you won't remember to ask for "COIN feedback structure with a SOLID quality check."</span>
            </li>
            <li style="display: flex; gap: 0.75rem;">
              <span style="color: var(--accent); flex-shrink: 0; margin-top: 0.1em;">→</span>
              <span><strong style="color: var(--text);">Forcing functions.</strong> A well-written skill pushes back on bad framing. Plain Claude is helpful in the direction you point it, even when the direction is wrong.</span>
            </li>
          </ul>
        </div>
        <div style="display: flex; flex-direction: column; gap: 1rem;">
          <div style="background: var(--bg-card); border: 1px solid var(--border); border-radius: 10px; padding: 1.25rem 1.5rem;">
            <p style="font-size: 0.82rem; color: var(--text-dim); margin: 0 0 0.5rem; font-family: var(--font-head); text-transform: uppercase; letter-spacing: 0.06em;">Without skills</p>
            <p style="color: var(--text); font-size: 0.92rem; margin: 0; line-height: 1.6;">"Can we throw an LLM at search?" → you write a half-hedged memo recommending the thing that was asked for. Engineering spends two weeks. It was a data problem all along.</p>
          </div>
          <div style="background: var(--accent-lo); border: 1px solid rgba(201,164,110,0.2); border-radius: 10px; padding: 1.25rem 1.5rem;">
            <p style="font-size: 0.82rem; color: var(--accent); margin: 0 0 0.5rem; font-family: var(--font-head); text-transform: uppercase; letter-spacing: 0.06em;">With skills</p>
            <p style="color: var(--text); font-size: 0.92rem; margin: 0; line-height: 1.6;"><code style="font-size: 0.82rem; background: rgba(0,0,0,0.3); padding: 0.1em 0.3em; border-radius: 3px;">the-reducer</code> fires and refuses the surface question. Walks you through whether this is an intelligence problem or a data problem. Monday memo: $0 fix, AI as a follow-on.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- ── Audiences ──────────────────────────────── -->
    <section style="padding: 5rem 2rem; border-top: 1px solid var(--border); max-width: 900px; margin: 0 auto;">
      <h2 style="
        font-family: var(--font-head); font-weight: 600;
        font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.08em;
        color: var(--text-dim); text-align: center; margin-bottom: 2.5rem;
      ">Built for</h2>
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 0.75rem;">
{[
           { title: 'AI Product Managers', detail: 'Decide if problems deserve AI. Run evals before engineering commits. Red-team before launch.' },
           { title: 'Engineering Managers', detail: 'Coach effectively without prescribing. Navigate performance conversations. Build promotion cases.' },
           { title: 'TPMs', detail: 'Lead across teams without authority. Navigate stakeholder complexity. Make decisions stick.' },
           { title: 'Senior ICs', detail: 'Influence architecture across teams. Drive technical strategy. Communicate without rank.' },
         ].map(({ title, detail }) => (
          <div style="background: var(--bg-card); border: 1px solid var(--border); border-radius: 10px; padding: 1.25rem;">
            <h3 style="font-family: var(--font-head); font-weight: 600; font-size: 0.95rem; color: var(--text-head); margin: 0 0 0.5rem;">{title}</h3>
            <p style="color: var(--text-dim); font-size: 0.85rem; margin: 0; line-height: 1.55;">{detail}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- ── Final CTA ──────────────────────────────── -->
    <section style="
      padding: 6rem 2rem;
      text-align: center;
      border-top: 1px solid var(--border);
      background: radial-gradient(ellipse 60% 60% at 50% 100%, rgba(201,164,110,0.06) 0%, transparent 60%);
    ">
<h2 style="
          font-family: var(--font-head); font-size: clamp(1.6rem, 3vw, 2.2rem);
          font-weight: 700; letter-spacing: -0.025em; color: var(--text-head);
          margin: 0 0 1rem; line-height: 1.2;
        ">Built for people who lead<br>with judgment, not just process.</h2>
      <p style="color: var(--text-dim); margin: 0 auto 2rem; max-width: 480px; line-height: 1.65;">
        Install in 60 seconds. Try <code style="font-size: 0.9em; background: var(--bg-card); padding: 0.1em 0.4em; border-radius: 4px; border: 1px solid var(--border);">/bettersense:user-profile</code> now and see how it transforms your next decision.
      </p>
      <a href="/getting-started/install" style="
        display: inline-flex; align-items: center; gap: 0.4rem;
        padding: 0.75rem 1.75rem;
        background: var(--accent); color: #111110;
        border-radius: 8px; font-weight: 600; font-size: 1rem;
        font-family: var(--font-head);
      ">
        Read the docs
